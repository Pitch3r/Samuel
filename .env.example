# Copy this file to .env.local (development) or set these variables on your host.

# Public address of the website, used in links, emails, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.primeresearch.co.zm

# Database. By default a SQLite file is created in ./data (needs a persistent disk).
# For serverless hosting (for example Vercel), use a Turso/libSQL database instead:
#   DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   DATABASE_AUTH_TOKEN=your-token
DATABASE_URL=file:./data/primeresearch.db
DATABASE_AUTH_TOKEN=

# Admin dashboard at /admin. Use a strong password of 12 or more characters.
ADMIN_EMAIL=admin@primeresearch.co.zm
ADMIN_PASSWORD=
# A long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email notifications (optional but recommended). Without SMTP_HOST, submissions
# are still saved and visible in the dashboard. Hostinger mailboxes use:
#   SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The "From" address on outgoing emails, for example: Primeresearch Consultants <info@primeresearch.co.zm>
MAIL_FROM=
# Where new enquiry notifications are sent. Defaults to the contact email in src/config/site.ts.
MAIL_TO=

# Set to "standalone" when building the Docker image (the Dockerfile does this for you).
NEXT_OUTPUT=
