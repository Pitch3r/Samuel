    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
