{
  "name": "primeresearch-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup-local.mjs",
    "preview": "next build && next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
