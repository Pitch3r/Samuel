{
  "name": "primeresearch-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Primeresearch Management System: assignments, progress, performance and reporting for Primeresearch Consultants",
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 FIREBASE_PROJECT_ID=demo-primeresearch SETUP_KEY=local-setup-key-123 next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --project demo-primeresearch",
    "seed:demo": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-primeresearch tsx scripts/seed-demo.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --project demo-primeresearch \"playwright test\"",
    "check:copy": "node scripts/check-copy.mjs",
    "verify": "npm run check:copy && npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
