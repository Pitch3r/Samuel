# Primeresearch Management System settings. Copy to .env.local for local use.
# On Firebase App Hosting, the Firebase project settings are provided for you;
# set SESSION_SECRET and SETUP_KEY as secrets (see apphosting.yaml).

# --- Firebase project (Project settings > General) ---
FIREBASE_PROJECT_ID=your-project-id
# Web API key (Project settings > General > Your apps > Web app). Used to check passwords.
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- Service account (only needed outside Google Cloud) ---
# Project settings > Service accounts > Generate new private key. Paste the whole
# JSON on one line, or its base64 encoding.
FIREBASE_SERVICE_ACCOUNT=

# --- Security ---
# A random value of at least 32 characters, for example from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Used once at /setup to create the administrator account (12+ characters).
SETUP_KEY=

# How to read the visitor's IP address for the office network check.
# auto | x-forwarded-for:1 | x-real-ip | cf-connecting-ip
CLIENT_IP_SOURCE=auto

# --- Local development with the Firebase emulators (npm run emulators) ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_PROJECT_ID=demo-primeresearch
